    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Prediction requests since replica startup",
          "description": "Each row is a replica. Columns show counts by HTTP status since that replica started.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (instance, status) (prediction_requests_total{job=\"prediction\", status!=\"\"})",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "groupingToMatrix",
                  "group": "groupingToMatrix",
                  "spec": {
                    "options": {
                      "columnField": "status",
                      "rowField": "instance",
                      "valueField": "Value"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.4",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
