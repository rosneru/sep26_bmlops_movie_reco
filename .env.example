# Copy this file to .env in the repository root before running Docker Compose.
# Choose your own password. Never commit .env.
# Grafana uses these values to initialize its admin account on first startup.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# DagsHub storage bucket, used by the data_collection_service.
# Create a token under DagsHub -> User Settings -> Tokens.
DAGSHUB_S3_ENDPOINT_URL=https://dagshub.com/api/v1/repo-buckets/s3/rosneru
DAGSHUB_BUCKET=sep26_bmlops_movie_reco
DAGSHUB_TOKEN=

# Training candidate only; does not switch the prediction service.
# Supported values: knn, two_tower. Build the selected image before running.
MODEL_TYPE=knn

# Serving selection is independent of training. Newest registered version at startup.
PREDICT_MODEL_TYPE=knn
PREDICT_MODEL_NAME=movie-genre-knn
PREDICT_MODEL_VERSION=latest

# Shared DagsHub-hosted MLflow. Uses DAGSHUB_TOKEN above as its password.
MLFLOW_TRACKING_URI=https://dagshub.com/rosneru/sep26_bmlops_movie_reco.mlflow
MLFLOW_TRACKING_USERNAME=
