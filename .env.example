# Copy this file to .env in the repository root before running Docker Compose.
# Choose your own password. Never commit .env.
# Grafana uses these values to initialize its admin account on first startup.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# DagsHub storage bucket, used by the data_collection_service.
# Create a token under DagsHub -> User Settings -> Tokens.
DAGSHUB_S3_ENDPOINT_URL=https://dagshub.com/api/v1/repo-buckets/s3/rosneru
DAGSHUB_BUCKET=sep26_bmlops_movie_reco
DAGSHUB_TOKEN=

# Training candidate only; does not switch the prediction service.
# Supported values: knn, two_tower. Build the selected image before running.
MODEL_TYPE=knn

# Serving selection is independent of training. Newest registered version at startup.
PREDICT_MODEL_TYPE=knn
PREDICT_MODEL_NAME=movie-genre-knn
PREDICT_MODEL_VERSION=latest

# Shared DagsHub-hosted MLflow. Uses DAGSHUB_TOKEN above as its password.
MLFLOW_TRACKING_URI=https://dagshub.com/rosneru/sep26_bmlops_movie_reco.mlflow
MLFLOW_TRACKING_USERNAME=

# Airflow metadata database (docker-compose.yml).
# Use a long random hexadecimal password; it is embedded in a connection URI.
# This account is for PostgreSQL, not the future Airflow dashboard login.
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_PASSWORD=

# Shared Airflow encryption/signing keys. Generate locally with:
# python airflow/setup_local.py
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# Airflow dashboard account, initialized in PostgreSQL by the API container.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=

# Absolute project root as seen by Docker Engine (not /opt/airflow).
# Generated by python airflow/setup_local.py. On Docker Desktop Windows, e.g.:
# /run/desktop/mnt/host/d/Git/Liora/MLOPS/Final Pro-Movie Reco-With Team
AIRFLOW_DOCKER_PROJECT_DIR=
# Socket group ID; Docker Desktop uses 0. Native Linux may use another ID.
AIRFLOW_DOCKER_GID=0
